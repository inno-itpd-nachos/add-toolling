// Cover page
#set page("a4")
#set text(size: 14pt)
#show link: underline

// Right-aligned content for most elements
#align(right)[
  #v(15%)
  #text(assignment-reference) \ \
  #text(size: 24pt, weight: "bold", title) \
  #text(size: 24pt, weight: "bold", "Architecture Scoring") \
  #v(20%)
  #text(weight: "bold", team-name + ":") \
  #text(team-members)
]

// Bottom center for date and university
#align(bottom + center)[
  #text(date),
  #text(university)
]

// Page break for the cover page
#pagebreak()

// Document structure with headers for the report content
#set heading(numbering: "1.")

